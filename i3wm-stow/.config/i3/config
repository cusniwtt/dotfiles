# i3 config file (v4)
#
# Please see https://i3wm.org/docs/userguide.html for a complete reference!
include autostart.conf		# Disable because use i3 as WM for xfce4
include keybinding.conf
include workspace.conf
include windowsrule.conf

# Font for window titles. Will also be used by the bar unless a different font
# is used in the bar {} block below.
#font pango:monospace 11
#font pango:Droid Sans 11
font pango:SF Thonburi 11

# This font is widely installed, provides lots of unicode glyphs, right-to-left
# text rendering and scalability on retina/hidpi displays (thanks to pango).
#font pango:DejaVu Sans Mono 11

# Start i3bar to display a workspace bar (plus the system information i3status
# finds out, if available)
bar {
	#output primary
	#output nonprimary
	#font pango:Droid Sans, FontAwesome 11
	font pango:SF Thonburi, FontAwesome 11
	position top
	strip_workspace_numbers yes
	#tray_output primary
	#status_command i3status-rs ~/.config/i3/i3status-rust.toml
	status_command i3status
	colors {
        	separator #666666
        	background #222222
        	statusline #dddddd
        	focused_workspace #0088CC #0088CC #ffffff
        	active_workspace #333333 #333333 #ffffff
        	inactive_workspace #333333 #333333 #888888
        	urgent_workspace #2f343a #900000 #ffffff
	}
}
