general {
        output_format = "i3bar"
        colors = true
        interval = 1
}
order += "disk /"
order += "volume master"
order += "wireless wlan0"
order += "tztime local"
wireless wlan0 {
        format_up = "W: %quality at %essid, %bitrate"
        format_down = "W: down"
}
ethernet eth0 {
        format_up = "E: %speed"
        format_down = "E: down"
}
battery 0 {
        format = "%status %percentage %remaining %emptytime"
        format_down = "No battery"
        status_chr = "⚡ CHR"
        status_bat = "🔋 BAT"
        status_unk = "? UNK"
        status_full = "☻ FULL"
        status_idle = "☻ IDLE"
        path = "/sys/class/power_supply/BAT%d/uevent"
        low_threshold = 10
}
tztime local {
        format = "%Y-%m-%d %H:%M:%S"
        hide_if_equals_localtime = true
}
disk "/" {
        format = "%free"
}
read_file uptime {
        path = "/proc/uptime"
}
volume master {
        format = "♪: %volume"
        format_muted = "♪: muted (%volume)"
        device = "default"
        mixer = "Master"
        mixer_idx = 0
}