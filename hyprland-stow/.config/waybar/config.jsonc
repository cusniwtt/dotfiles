{
    "layer": "top", // Waybar at top layer
    "position": "top", // Waybar position (top|bottom|left|right)
    "spacing": 1, // Gaps between modules (4px)
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,
    "margin-bottom": 0,

    // Choose the order of the modules
    "modules-left": [
        "hyprland/workspaces",
	//"hyprland/windowcount",
        "hyprland/window"
    ],
    "modules-center": [
	"clock#date"        
    ],
    "modules-right": [
        //"custom/weather",
        "disk",
        "cpu",
        "memory",
        //"wireplumber",
	"pulseaudio",
        "hyprland/language",
        "bluetooth",
        "network",
	"tray"
    ],

    // Modules configuration
    "hyprland/workspaces": {
        "on-click": "activate",
        "format": "{name}",
        "persistent-workspaces": {"*": 5},
        "all-outputs": true
    },

    "hyprland/language": {
        "format": "{}",
        "min-length": 2,
        "max-length": 3,
        "format-en": "EN",
        "format-th": "TH"
    },

    "hyprland/window": {
        //"format": "  [ {class} ] {title}"
        "format": "[<span style='italic'> {class} </span>] {title}"
        //"max-length": 50
    },

    "hyprland/windowcount": {
    	"format": "[{}]=",
    	//"format-empty": "[X]",
    	//"format-windowed": "[T]",
    	// "format-fullscreen": "[{}]",
    	"separate-outputs": true
    },

    "tray": {
        "icon-size": 16,
        "spacing": 5
    },

    "clock": {
        "format": "{:%I:%M %p}"
        //"format-alt": "{:%d %B %Y %R}"
        //"tooltip-format": "{:%d %B %Y}"
    },

    "clock#date": {
        "format": "{:%a, %e %B  %I:%M %p}", // Icon: calendar-alt
        //"format": "{:%I:%M %p  %A %b %d}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "today-format": "<b>{}</b>"
    },

    "cpu": {
        "interval": 1,
        "format": "<span foreground='#93C572'>  </span>{usage}%", // Icon: microchip
        "max-length": 7,
        "min-length": 7
    },

    "memory": {
        "interval": 1,
        "format": "<span foreground='#1793d1'>  </span>{used:0.2f}GiB",
        "max-length": 10,
        "min-length": 10
    },
    
    "disk": {
        "format": "<span foreground='#fab387'>  </span>{free} ",
        "path": "/home",
        "interval": 30
    },

    "network": {
        "format-wifi": "<span foreground='#93C572'>{icon} {essid}</span>  ",
        "format-icons": ["󰤟 ", "󰤢 ", "󰤥 ", "󰤨 "],
        "format-ethernet": "<span foreground='#93C572'> {ifname}</span>  ",
        "format-linked": "{ifname} (No IP) ",
        "format": "",
        "format-disconnected": "",
        //"format-alt": "{ipaddr}/{cidr}",
        "on-click": "nm-connection-editor",
        //"on-click": "wl-copy $(ip address show up scope global | grep inet | head -n1 | cut -d/ -f 1 | tr -d [:space:] | cut -c5-)",
        //"on-click-right": "wl-copy $(ip address show up scope global | grep inet6 | head -n1 | cut -d/ -f 1 | tr -d [:space:] | cut -c6-)",
        "tooltip-format": " {bandwidthUpBits}\n {bandwidthDownBits}\n{ifname}\n{ipaddr}/{cidr}",
        "tooltip-format-wifi": "󱚻 {essid} {frequency}MHz\nStrength: {signaldBm}dBm ({signalStrength}%)\nIP: {ipaddr}/{cidr}\n {bandwidthUpBits}  {bandwidthDownBits}",
        "interval": 1
    },

    "bluetooth": {
	    //"controller": "controller1", // specify the alias of the controller if there are more than 1 on the system
        "format": "<span foreground='#1793d1'> </span> ",
	    "format-disabled": " ", // an empty format will hide the module
        "format-connected": "<span foreground='#1793d1'> {num_connections}</span>  ",
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "on-click": "blueman-manager"
    },

    "pulseaudio": {
        // "scroll-step": 1, // %, can be a float
        "format": "<span foreground='#fab387'>{volume}% {icon}</span>",
        "tooltip": true,
        "tooltip-format": "{volume}%",
        "format-bluetooth": "{volume}% {icon} {format_source}",
        "format-bluetooth-muted": " {icon} {format_source}",
        "format-muted": " {format_source}",
        "format-source": " {volume}%",
        "format-source-muted": " ",
        "format-icons": {
            "headphone": " ",
            "hands-free": " ",
            "headset": " ",
            "phone": " ",
            "portable": " ",
            "car": " ",
            "default": [" ", " ", " ", " "]
        },
        "on-click": "pavucontrol"
    },

    "wireplumber": {
        "on-click": "pavucontrol",
        "on-click-right": "amixer sset Master toggle 1>/dev/null",
        //on-click: "${wpctl} set-mute @DEFAULT_AUDIO_SINK@ toggle";
        //on-scroll-down: "${wpctl} set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 0.04+";
        //on-scroll-up: "${wpctl} set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 0.04-";
        "format": "<span foreground='#fab387'>{icon}{volume}%</span>",
        "format-muted": " ",
        "format-source": "",
        "format-source-muted": " ",
        //"format-muted": "<span foreground='#fab387'> </span>",
        //"format-icons": [ "<span foreground='#fab387'></span>" ]
        "format-icons": {
            "headphone": " ",
            "hands-free": " ",
            "headset": " ",
            "phone": " ",
            "portable": " ",
            "car": " ",
            "default": [" ", " ", " ", " "]
        }
    },

    "custom/weather": {
        "format": "{}",
        "interval": 600,
        "exec": "curl -s 'https://wttr.in/?format=1'",
        "exec-if": "ping wttr.in -c1"
    },

    "custom/power": {
        "format": "",
        "tooltip": false,
        "on-click": "wlogout"
    }
    
}

